#!/usr/bin/env node
import { spawn, spawnSync } from 'node:child_process';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { OutputStore } from '../optimizer/output-store.mjs';
const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..'); const args = process.argv.slice(2); const cmd = args.shift();
function run(name, argv, opts = {}) { const child = spawnSync(name, argv, { stdio:'inherit', ...opts }); if (child.error) { console.error(`${name}: ${child.error.message}`); process.exit(1); } process.exit(child.status ?? 1); }
function help() { console.log(`codex-forge commands:\n  doctor\n  opencodex install --yes | start | service | init | gui | doctor\n  optimizer start | enable | disable | stats\n  output get <sha256> [--offset N] [--length N]\n  output grep <sha256> <text>\n  output tail <sha256> [bytes]\n  test [--live --yes]`); }
if (!cmd || cmd === 'help' || cmd === '--help') { help(); process.exit(0); }
if (cmd === 'doctor') {
  const checks = [['node >= 18', Number(process.versions.node.split('.')[0]) >= 18], ['ocx installed', spawnSync('ocx', ['--help'], { stdio:'ignore' }).status === 0], ['codex installed', spawnSync('codex', ['--version'], { stdio:'ignore' }).status === 0]];
  for (const [name, ok] of checks) console.log(`[${ok ? 'ok' : 'ko'}] ${name}`);
  const health = spawnSync('curl', ['-fsS','http://127.0.0.1:10100/healthz'], { stdio:'ignore' }).status === 0; console.log(`[${health ? 'ok' : 'info'}] OpenCodex proxy ${health ? 'reachable' : 'not running on :10100'}`); process.exit(checks.some(([,ok]) => !ok) ? 1 : 0);
}
if (cmd === 'opencodex') {
  const sub = args.shift();
  if (sub === 'install') { if (!args.includes('--yes')) { console.error('Refusing network install without --yes. Run: codex-forge opencodex install --yes'); process.exit(2); } run('npm', ['install','-g','@bitkyc08/opencodex']); }
  if (['start','init','gui','doctor'].includes(sub)) run('ocx', [sub, ...args]);
  if (sub === 'service') run('ocx', ['service','install', ...args]); help(); process.exit(2);
}
if (cmd === 'optimizer') {
  const sub = args.shift();
  if (sub === 'start') { const child = spawn(process.execPath, [path.join(root,'optimizer/server.mjs')], { stdio:'inherit', env:process.env }); child.on('exit', code => process.exit(code ?? 1)); }
  else if (sub === 'enable' || sub === 'disable') { const { setOptimizerRouting } = await import('../optimizer/codex-config.mjs'); try { const result = await setOptimizerRouting({ enable:sub === 'enable' }); console.log(result.changed ? `[ok] optimizer routing ${sub}d` : `[ok] already ${sub}d`); process.exit(0); } catch (error) { console.error(`[ko] ${error.message}`); process.exit(1); } }
  else if (sub === 'stats') { const response = await fetch(`http://${process.env.CODEX_FORGE_LISTEN_HOST || '127.0.0.1'}:${process.env.CODEX_FORGE_LISTEN_PORT || 10101}/_codex_forge/stats`); console.log(JSON.stringify(await response.json(), null, 2)); process.exit(response.ok ? 0 : 1); }
  else { help(); process.exit(2); }
} else if (cmd === 'output') {
  const sub = args.shift(); const hash = args.shift(); if (!hash) { help(); process.exit(2); }
  const store = new OutputStore({ root:path.join(process.env.CODEX_FORGE_STATE_DIR || path.join(process.env.HOME || '.', '.codex-forge'), 'tool-output') });
  if (sub === 'get') { const oi=args.indexOf('--offset'), li=args.indexOf('--length'); process.stdout.write(await store.get(hash,{offset:oi>=0?Number(args[oi+1]):0,length:li>=0?Number(args[li+1]):undefined})); process.exit(0); }
  if (sub === 'tail') { const bytes=Number(args[0]||8192), file=store.file(hash), info=await import('node:fs/promises').then(m=>m.stat(file)); process.stdout.write(await store.get(hash,{offset:Math.max(0,info.size-bytes)})); process.exit(0); }
  if (sub === 'grep') { for (const hit of await store.grep(hash,args.join(' '))) console.log(`${hit.line}:${hit.text}`); process.exit(0); }
  help(); process.exit(2);
} else if (cmd === 'test') run('bash',[path.join(root,'scripts/test-all.sh'),...args],{env:process.env}); else { help(); process.exit(2); }
